# ===== LLM provider =====
# mistral | anthropic | openai | (AIHQ_FAKE_LLM=1 for a fake LLM without keys)
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Put 1 here to get deterministic local answers without consuming any credit (demo and testing)
AIHQ_FAKE_LLM=

# ===== Database =====
# auto → Supabase if reachable, otherwise local SQLite
# supabase → forced (fails loudly if the connection fails)
# sqlite → always SQLite (offline mode)
DB_BACKEND=auto
DATABASE_URL=
# connection pool settings (optional — auto manages 1-5 connections)
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_MAX_IDLE=60
DB_POOL_MAX_LIFETIME=300

# ===== Etsy (Open API v3 — documented on Etsy Developers) =====
# ETSY_KEYSTRING:       Open API v3 key (name on Etsy: keystring)
# ETSY_SHARED_SECRET:   accompanies ETSY_KEYSTRING, issued by Etsy → Apps → Your app
# ETSY_REFRESH_TOKEN:   long-lived OAuth access token (auto-refreshed)
# ETSY_SHOP_ID:         your shop's ID on Etsy
# ETSY_TAXONOMY_ID:     Taxonomy ID (default: handmade items)
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
ETSY_TAXONOMY_ID=116

# ===== AI Business HQ — Frontend =====
FOUNDER_TOKEN=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public API address for the frontend build (bake at build time)
NEXT_PUBLIC_API_URL=http://localhost:8700
ENABLE_SCHEDULER=
TZ=Europe/Berlin
