# ===== مزود الذكاء =====
# mistral | anthropic | openai | (AIHQ_FAKE_LLM=1 للتجريبي دون مفاتيح)
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ضع 1 هنا للحصول على إجابات حتمية محلية بلا استهلاك أي رصيد (العرض والاختبار)
AIHQ_FAKE_LLM=

# ===== قاعدة البيانات =====
# auto → Supabase إن أمكن الاتصال، وإلا SQLite محلياً
# supabase → قسري (يشتكي إذا فشل الاتصال)
# sqlite → SQLite دائماً (وضع بدون إنترنت)
DB_BACKEND=auto
DATABASE_URL=

# ===== Etsy (Open API v3 — مستند على Etsy Developers) =====
# ETSY_KEYSTRING:       مفتاح Open API v3 (الاسم في Etsy: keystring)
# ETSY_SHARED_SECRET:   يلازم ETSY_KEYSTRING، تُصدر من Etsy → Apps → Your app
# ETSY_REFRESH_TOKEN:   OAuth access token طويل الأجل (يُحدّث تلقائياً)
# ETSY_SHOP_ID:         الرقم التعريفي لمتجرك على Etsy
# ETSY_TAXONOMY_ID:     الرقم التعريفي لـ Taxonomy (الإنشطة اليدوية الافتراضية)
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
ETSY_TAXONOMY_ID=116

# ===== AI Business HQ — الواجهة =====
FOUNDER_TOKEN=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# العنوان العام للـ API لأجل البناء الأمامي (bake at build time)
NEXT_PUBLIC_API_URL=http://localhost:8700
ENABLE_SCHEDULER=
TZ=Europe/Berlin
